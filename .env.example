# Local demo. Copy to .env; keep actual secrets out of source control.
DEMO_MODE=true
ALLOW_EXTERNAL_WRITES=false
PUBLIC_URL=http://127.0.0.1:8000
# Production: IBM Db2 LUW. URL-encode the username/password and query values.
# DATABASE_URL=db2+ibm_db://USER:URL_ENCODED_PASSWORD@DB2_HA_HOST:50001/RCCDB?SECURITY=SSL&SSLServerCertificate=/etc/release-command-center/db2-ca.arm
# Db2 automatic client reroute is configured by the DBA in the IBM driver/server.
DATABASE_URL=
ENTRA_TENANT_ID=
# Application (client) ID; configure token version 2 and roles in Entra.
ENTRA_AUDIENCE=
# Optional, separate API-token audience. Leave empty for browser-session-only access.
ENTRA_API_AUDIENCE=
ENTRA_CLIENT_SECRET=
WEBHOOK_TOKEN=
# API_KEY applies only to a local demo, not production company sign-in.
API_KEY=

SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_TOKEN=
# Instance custom environment field (example: u_environment). Values must match DEV/INT/QAT/PROD.
# Without this field, explicitly select task_numbers on every task sync.
SERVICENOW_ENV_FIELD=
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Automatic current-environment ServiceNow/Jira polling. 0 disables scheduled polling.
AUTO_SYNC_SECONDS=300
# Block live completion when imported activity status is older than this threshold.
SOURCE_MAX_AGE_SECONDS=900
# If enabled with external writes, preparation queues stakeholder emails automatically.
AUTO_QUEUE_EMAIL=false
